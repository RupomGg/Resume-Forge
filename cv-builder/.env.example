# Copy to .env.local and fill in.

# Random 32+ char secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Database. Local dev uses a SQLite file; production uses Turso (libsql://...) + token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
